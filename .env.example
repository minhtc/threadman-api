PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/game_db?sslmode=disable
# SCHEMA_PATH=database/schema.sql
LEADERBOARD_TIMEZONE=Asia/Ho_Chi_Minh

# 32-byte base64 key used only to encrypt session secrets at rest.
# Generate with: openssl rand -base64 32
SESSION_SECRET_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# CORS configuration (restrict to your client origins)
ALLOWED_ORIGINS=https://threadman.homielab.com,https://threadman-api.homielab.com,capacitor://localhost

# Set true only when requests arrive through the listed trusted proxy networks.
TRUST_PROXY=false
PROXY_HEADER=CF-Connecting-IP
TRUSTED_PROXIES=

# Optional operational tuning
# SESSION_TTL=10m
# PRUNE_INTERVAL=15m
# DB_MAX_CONNS=15
# DB_MIN_CONNS=3
# REQUEST_TIMEOUT=3s
# READINESS_TIMEOUT=2s
# PRUNE_TIMEOUT=5s
# DB_CONNECT_TIMEOUT=5s
# DB_PING_TIMEOUT=5s
# READ_TIMEOUT=10s
# WRITE_TIMEOUT=10s
# IDLE_TIMEOUT=30s
